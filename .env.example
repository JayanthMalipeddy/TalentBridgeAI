APP_ENV=development
FRONTEND_ORIGIN=http://localhost:5173
DATABASE_URL=sqlite:///./data/talentbridge.db
RECRUITER_API_TOKEN=
LLM_PROVIDER=groq
GROQ_API_KEY=
# Select a JSON-mode model currently available to your Groq account.
GROQ_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
OLLAMA_BASE_URL=
OLLAMA_MODEL=
# Set a local Sentence Transformers model path; no startup downloads.
EMBEDDING_MODEL=
EMBEDDING_MAX_LENGTH=512
CHROMA_PATH=./data/chroma
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_WEBHOOK_SECRET=
ELEVENLABS_VOICE_ENABLED=false
ELEVENLABS_SUPERVISED=false
KEENABLE_API_KEY=
TAVILY_API_KEY=
LLAMA_CLOUD_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
# Explicit lifetime quotas; empty denies all calls. No automatic paid overages.
PROVIDER_BUDGET_LIMITS={}
SESSION_TTL_SECONDS=3600
SESSION_DURATION_SECONDS=360
SESSION_MAX_DURATION_SECONDS=480
MAX_CV_BYTES=1000000

# Guest workspaces: HTTP-only cookie, CSRF, exact origin and per-workspace caps.
GUEST_TTL_SECONDS=86400
GUEST_MAX_WORKSPACES=100
GUEST_MAX_CASES=5
GUEST_MAX_OPERATIONS=30
WORKFLOW_AUTO_PROCESS=false
PLANNING_MAX_CV_PAGES=10
# Provisional mode NEVER permits numerical scoring of pending-review criteria.
PLANNING_ALLOW_PENDING_REVIEW=false
PLANNING_ENABLE_TAVILY_FALLBACK=false
PLANNING_LLAMAPARSE_TIER=
LLM_MAX_COMPLETION_TOKENS=4096
INTERVIEW_FOLLOWUPS_ENABLED=true
