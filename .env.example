APP_ENV=development
FRONTEND_ORIGIN=http://localhost:5173
DATABASE_URL=sqlite:///./data/talentbridge.db
RECRUITER_API_TOKEN=
LLM_PROVIDER=groq
GROQ_API_KEY=
# Select a JSON-mode model currently available to your Groq account.
GROQ_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
OLLAMA_BASE_URL=
OLLAMA_MODEL=
# Set a local Sentence Transformers model path; no startup downloads.
EMBEDDING_MODEL=
EMBEDDING_MAX_LENGTH=512
CHROMA_PATH=./data/chroma
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_WEBHOOK_SECRET=
KEENABLE_API_KEY=
TAVILY_API_KEY=
LLAMA_CLOUD_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
# Explicit lifetime quotas; empty denies all calls. No automatic paid overages.
PROVIDER_BUDGET_LIMITS={}
SESSION_TTL_SECONDS=3600
SESSION_MAX_DURATION_SECONDS=1800
MAX_CV_BYTES=1000000
